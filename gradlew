#!/usr/bin/env sh
#
# Gradle wrapper script for AlarmTask
# Generated by Claude Code build engineer to enable consistent builds.
#
set -e

# Resolve the directory containing this script as the project root.
DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$DIR"

# Use GRADLE_USER_HOME if set, otherwise default to ~/.gradle.
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"

WRAPPER_DIR="$PROJECT_ROOT/gradle/wrapper"
PROPERTIES_FILE="$WRAPPER_DIR/gradle-wrapper.properties"

if [ ! -f "$PROPERTIES_FILE" ]; then
    echo "ERROR: gradle-wrapper.properties not found at $PROPERTIES_FILE" >&2
    exit 1
fi

# Extract distributionUrl from the properties file.
DISTRIBUTION_URL=$(grep '^distributionUrl=' "$PROPERTIES_FILE" | cut -d= -f2-)
if [ -z "$DISTRIBUTION_URL" ]; then
    echo "ERROR: distributionUrl not found in gradle-wrapper.properties" >&2
    exit 1
fi

# Compute the local gradle distribution path.
DISTRIBUTION_BASE="${GRADLE_USER_HOME}/wrapper/dists"
GRADLE_VERSION=$(echo "$DISTRIBUTION_URL" | sed -E 's#.*/gradle-([0-9.]+)-bin\.zip#\1#')
DIST_HASH=$(echo "$DISTRIBUTION_URL" | sha256sum | cut -c1-12)
DIST_DIR="$DISTRIBUTION_BASE/gradle-$GRADLE_VERSION-bin/$DIST_HASH"

GRADLE_BIN="$DIST_DIR/gradle-$GRADLE_VERSION/bin/gradle"

# Download the distribution if it doesn't exist yet.
if [ ! -x "$GRADLE_BIN" ]; then
    echo "Downloading Gradle $GRADLE_VERSION..."
    mkdir -p "$DIST_DIR"
    TMP_ZIP=$(mktemp)
    curl -sSL "$DISTRIBUTION_URL" -o "$TMP_ZIP"
    unzip -q "$TMP_ZIP" -d "$DIST_DIR"
    rm -f "$TMP_ZIP"
    chmod +x "$DIST_DIR/gradle-$GRADLE_VERSION/bin/gradle"
fi

# Execute Gradle with the project's JVM args from gradle.properties.
exec "$GRADLE_BIN" -p "$PROJECT_ROOT" "$@"