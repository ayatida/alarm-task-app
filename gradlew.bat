@echo off
REM Gradle wrapper script for AlarmTask (Windows)
REM Generated by Claude Code build engineer to enable consistent builds.

setlocal

set PROJECT_ROOT=%~dp0
set GRADLE_USER_HOME=%GRADLE_USER_HOME%%HOMEDRIVE%%HOMEPATH%.gradle
if "%GRADLE_USER_HOME%"=="%HOMEDRIVE%%HOMEPATH%.gradle" set GRADLE_USER_HOME=%HOMEDRIVE%%HOMEPATH%.gradle

set WRAPPER_DIR=%PROJECT_ROOT%gradle\wrapper
set PROPERTIES_FILE=%WRAPPER_DIR%\gradle-wrapper.properties

if not exist "%PROPERTIES_FILE%" (
    echo ERROR: gradle-wrapper.properties not found at %PROPERTIES_FILE%
    exit /b 1
)

for /f "tokens=1,* delims==" %%a in (%PROPERTIES_FILE%) do (
    if "%%a"=="distributionUrl" set DISTRIBUTION_URL=%%b
)

if "%DISTRIBUTION_URL%"=="" (
    echo ERROR: distributionUrl not found in gradle-wrapper.properties
    exit /b 1
)

set DIST_BASE=%GRADLE_USER_HOME%\wrapper\dists
set DIST_DIR=%DIST_BASE%\gradle-8.9-bin\*
if exist "%DIST_DIR%" (
    for /d %%d in ("%DIST_DIR%") do set DIST_DIR=%%d
)

set GRADLE_BIN=%DIST_DIR%\gradle-8.9\bin\gradle.bat

if not exist "%GRADLE_BIN%" (
    echo Downloading Gradle 8.9...
    mkdir "%DIST_DIR%" 2>nul
    powershell -Command "[Net.ServicePointManager]::SecurityProtocol = 'Tls12'; (New-Object System.Net.WebClient).DownloadFile('%DISTRIBUTION_URL%', '%TEMP%\gradle.zip')"
    powershell -Command "Expand-Archive -Path '%TEMP%\gradle.zip' -DestinationPath '%DIST_DIR%' -Force"
    del "%TEMP%\gradle.zip" 2>nul
)

if not exist "%GRADLE_BIN%" (
    echo ERROR: Gradle executable not found at %GRADLE_BIN%
    exit /b 1
)

call "%GRADLE_BIN%" -p "%PROJECT_ROOT%" %*
endlocal